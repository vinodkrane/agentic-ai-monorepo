AWS_REGION=eu-west-2
# AWS_PROFILE=kb-rag-dev

# localstack for s3/sqs/dynamodb. remove in real AWS
AWS_ENDPOINT_URL=http://localhost:4566
DOCS_BUCKET=kb-rag-docs-dev
INGEST_QUEUE_URL=http://localhost:4566/000000000000/kb-rag-ingest-dev
STATUS_TABLE=kb-rag-doc-status-dev

# ingest worker
MAX_RECEIVE_COUNT=3
VISIBILITY_TIMEOUT=300
HEARTBEAT_SECONDS=60
RETRY_DELAY_SECONDS=60
POLL_WAIT_SECONDS=20

OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_USE_IAM=false
INDEX_NAME=kb-chunks-v1

EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
EMBED_DIM=1024
LLM_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
JUDGE_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0

RERANK_ENABLED=true
TOP_K=5
