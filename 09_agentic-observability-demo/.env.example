# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# ---- OpenAI ----
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini

# ---- LangSmith ----
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_your-langsmith-key
LANGSMITH_PROJECT=streambox-agent
# US region (default). If your LangSmith account is in the EU region use:
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ---- App ----
PROMPT_VERSION=v1
TOP_K=2
MAX_QUESTION_CHARS=500

# ---- Logging ----
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
# Set to true only while debugging. It writes user questions into the log file.
LOG_QUESTIONS=false
